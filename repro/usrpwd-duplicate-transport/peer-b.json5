{
  mode: "peer",
  connect: {
    endpoints: ["tcp/127.0.0.1:18001"],
    timeout_ms: { peer: -1 },
    exit_on_failure: { peer: false },
    retry: {
      period_init_ms: 200,
      period_max_ms: 200,
      period_increase_factor: 1,
    },
  },
  listen: {
    endpoints: ["tcp/127.0.0.1:18002"],
    exit_on_failure: true,
  },
  scouting: {
    multicast: { enabled: false },
    gossip: { enabled: false },
  },
  transport: {
    auth: {
      usrpwd: {
        user: "demo-user",
        password: "demo-password",
        dictionary_file: "repro/usrpwd-duplicate-transport/usrpwd_dictionary.txt",
      },
    },
    shared_memory: {
      enabled: false,
    },
  },
}
